# Microsoft Entra External ID (CIAM) — native auth (email + password + OTP)
# Get client id / authority from: entra.microsoft.com -> App registrations -> InkoopMatch-Frontend -> Overview
VITE_ENTRA_CLIENT_ID=your-application-client-id
VITE_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>

# CORS proxy required by native auth (see cors.js for local dev).
VITE_AUTH_PROXY_URL=http://localhost:3001/api
